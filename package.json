{
  "name": "obsidian-email",
  "version": "0.1.0",
  "private": true,
  "description": "A full Microsoft 365 email client inside Obsidian.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^24",
    "esbuild": "^0.21.5",
    "esbuild-svelte": "^0.8.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^24.1.0",
    "obsidian": "^1.11.4",
    "svelte": "^5.0.0",
    "tslib": "^2.6.3",
    "typescript": "^5.5.2",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "idb": "^8.0.0"
  }
}
