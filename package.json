{
  "name": "obsidian-email",
  "version": "0.12.11",
  "private": true,
  "description": "A full Microsoft 365 email client inside Obsidian.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "obsidian": "^1.14.4",
    "svelte": "^5.57.2",
    "tslib": "^2.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "quill": "^2.0.3",
    "turndown": "^7.2.4"
  }
}
